{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "score": { "type": "integer", "minimum": 0, "maximum": 10 },
    "passed": { "type": "boolean" },
    "feedback": { "type": "string", "minLength": 12, "maxLength": 600 }
  },
  "required": ["score", "passed", "feedback"],
  "additionalProperties": false
}
